<?xml version="1.0" encoding="utf-8"?>
<!-- The clip card: the keyboard's key colour on the keyboard field, with Gboard's soft corner.
     The attr resolves under the themed framework inflation context; runtime themes retint the
     same drawable in ClipboardHistoryView.applyRuntimeRowColors. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
  <solid android:color="?attr/colorKey"/>
  <corners android:radius="12dp"/>
</shape>
