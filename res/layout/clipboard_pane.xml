<?xml version="1.0" encoding="utf-8"?>
<!-- Gboard-style clipboard surface. The pane is inflated by ClipboardManager via
     View.inflate(ContextThemeWrapper(imeService, config.theme), …) — a FRAMEWORK LayoutInflater
     with no AppCompat factory, so <ImageView>/<ImageButton> inflate as framework widgets that
     IGNORE app:tint entirely (only AppCompatImageView reads it). android:tint is applied natively
     (setImageTintList on API 21+) and keeps every icon on ?attr/colorLabel, matching the
     programmatic tints (applyRuntimeThemeColors) that resolve the same attr.

     Layout contract (ClipboardPaneLayout.onMeasure): the controls row is VERTICAL on a phone,
     HORIZONTAL on a wide/landscape pane. All ids used by ClipboardManager stay here; only their
     grouping changes. The header owns navigation (back, title, search, filter, edit), the second
     row owns the three tabs plus the search field, and the list owns rounded Gboard-like cards. -->
<tribixbite.cleverkeys.ClipboardPaneLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:background="?attr/colorKeyboard"
    android:hardwareAccelerated="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="Overdraw">

  <LinearLayout android:id="@+id/clipboard_controls"
      android:layout_width="match_parent" android:layout_height="wrap_content"
      android:orientation="vertical" android:gravity="center_vertical">

    <!-- Gboard's header: back arrow, a real "Clipboard" title, and the actions on the right.
         The old pane had no title at all — just a row of unlabelled icons and a search box,
         which is why it never read as the clipboard surface the owner sees in Gboard. -->
    <LinearLayout android:id="@+id/clipboard_toolbar"
        android:layout_width="match_parent" android:layout_height="56dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="6dp" android:paddingEnd="6dp"
        android:background="?attr/colorKeyboard">

      <ImageButton
          android:id="@+id/clipboard_close_button"
          android:layout_width="40dp"
          android:layout_height="40dp"
          android:src="@drawable/ic_clipboard_back"
          android:tint="?attr/colorLabel"
          tools:ignore="UseAppTint"
          android:background="?android:attr/selectableItemBackgroundBorderless"
          android:contentDescription="@string/clipboard_back"
          android:scaleType="centerInside"
          android:padding="8dp"/>

      <TextView
          android:id="@+id/clipboard_title"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:layout_marginStart="4dp"
          android:text="@string/clipboard_title"
          android:textSize="20sp"
          android:textStyle="bold"
          android:textColor="?attr/colorLabel"
          android:maxLines="1"
          android:ellipsize="end"/>

      <!-- Search is a header action that expands into the second row. Gboard has no permanent
           search field; leaving it out of the resting state is what makes the header look right. -->
      <ImageButton
          android:id="@+id/clipboard_search_toggle"
          android:layout_width="40dp"
          android:layout_height="40dp"
          android:src="@drawable/ic_clipboard_search"
          android:tint="?attr/colorLabel"
          tools:ignore="UseAppTint"
          android:background="?android:attr/selectableItemBackgroundBorderless"
          android:contentDescription="@string/clipboard_search_open"
          android:scaleType="centerInside"
          android:padding="9dp"/>

      <ImageButton
          android:id="@+id/clipboard_date_filter"
          android:layout_width="40dp"
          android:layout_height="40dp"
          android:src="@drawable/ic_clipboard_filter"
          android:tint="?attr/colorLabel"
          tools:ignore="UseAppTint"
          android:background="?android:attr/selectableItemBackgroundBorderless"
          android:contentDescription="@string/clipboard_date_filter"
          android:scaleType="centerInside"
          android:padding="9dp"/>

      <!-- The pencil: Gboard's edit affordance enters selection mode, where the row of five
           batch actions replaces this button. Kept as a Button so its themed background tint
           and 48dp target stay the same across the toolbar and the selection bar. -->
      <Button
          android:id="@+id/clipboard_select"
          android:layout_width="48dp"
          android:layout_height="48dp"
          android:minWidth="48dp"
          android:text=""
          android:drawableTop="@drawable/ic_clipboard_edit"
          android:drawablePadding="0dp"
          android:drawableTint="?attr/colorLabel"
          android:paddingTop="7dp"
          android:paddingBottom="5dp"
          android:paddingStart="0dp"
          android:paddingEnd="0dp"
          android:backgroundTint="?attr/colorKey"
          android:contentDescription="@string/clipboard_edit_mode"
          android:enabled="false"/>
    </LinearLayout>

    <!-- Tab row. The icons keep their ids/drawables (the tab wiring and the layout tests pin
         them), but they now sit inside labelled chips: "Recent / Pinned / To-dos" reads as
     information architecture, not as three mystery glyphs. -->
    <LinearLayout
        android:id="@+id/clipboard_search_bar"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:background="?attr/colorKeyboard">

      <LinearLayout
          android:id="@+id/clipboard_tab_recent_chip"
          android:layout_width="wrap_content"
          android:layout_height="34dp"
          android:orientation="horizontal"
          android:gravity="center_vertical"
          android:paddingStart="9dp"
          android:paddingEnd="9dp"
          android:layout_marginEnd="4dp"
          android:background="@drawable/clipboard_tab_chip_bg">

        <ImageView
            android:id="@+id/tab_history"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_tab_history"
            android:tint="?attr/colorLabel"
            tools:ignore="UseAppTint"
            android:scaleType="centerInside"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/clipboard_tab_history"/>

        <TextView
            android:id="@+id/clipboard_tab_recent_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="@string/clipboard_tab_recent_label"
            android:textSize="13sp"
            android:textColor="?attr/colorLabel"
            android:maxLines="1"
            android:ellipsize="end"/>
      </LinearLayout>

      <LinearLayout
          android:id="@+id/clipboard_tab_pinned_chip"
          android:layout_width="wrap_content"
          android:layout_height="34dp"
          android:orientation="horizontal"
          android:gravity="center_vertical"
          android:paddingStart="9dp"
          android:paddingEnd="9dp"
          android:layout_marginEnd="4dp"
          android:background="@drawable/clipboard_tab_chip_bg">

        <ImageView
            android:id="@+id/tab_pinned"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_tab_pinned"
            android:tint="?attr/colorLabel"
            tools:ignore="UseAppTint"
            android:scaleType="centerInside"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/clipboard_tab_pinned"/>

        <TextView
            android:id="@+id/clipboard_tab_pinned_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="@string/clipboard_tab_pinned_label"
            android:textSize="13sp"
            android:textColor="?attr/colorLabel"
            android:maxLines="1"
            android:ellipsize="end"/>
      </LinearLayout>

      <LinearLayout
          android:id="@+id/clipboard_tab_todos_chip"
          android:layout_width="wrap_content"
          android:layout_height="34dp"
          android:orientation="horizontal"
          android:gravity="center_vertical"
          android:paddingStart="9dp"
          android:paddingEnd="9dp"
          android:layout_marginEnd="4dp"
          android:background="@drawable/clipboard_tab_chip_bg">

        <ImageView
            android:id="@+id/tab_todos"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_tab_todos"
            android:tint="?attr/colorLabel"
            tools:ignore="UseAppTint"
            android:scaleType="centerInside"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/clipboard_tab_todos"/>

        <TextView
            android:id="@+id/clipboard_tab_todos_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="@string/clipboard_tab_todos_label"
            android:textSize="13sp"
            android:textColor="?attr/colorLabel"
            android:maxLines="1"
            android:ellipsize="end"/>
      </LinearLayout>

      <!-- Revealed by the header's search icon, and replaces the chips while open. -->
      <TextView
          android:id="@+id/clipboard_search"
          android:hint="@string/clipboard_search_hint"
          android:layout_width="0dp"
          android:layout_height="34dp"
          android:layout_weight="1"
          android:layout_marginStart="4dp"
          android:layout_marginEnd="4dp"
          android:gravity="center_vertical"
          android:textSize="14sp"
          android:textColor="?attr/colorLabel"
          android:textColorHint="?attr/colorSubLabel"
          android:paddingStart="12dp"
          android:paddingEnd="12dp"
          android:background="@drawable/clipboard_card_bg"
          android:singleLine="true"
          android:ellipsize="end"
          android:clickable="true"
          android:focusable="true"
          android:visibility="gone"/>

      <ImageButton
          android:id="@+id/clipboard_search_clear"
          android:layout_width="28dp"
          android:layout_height="28dp"
          android:src="@android:drawable/ic_menu_close_clear_cancel"
          android:tint="?attr/colorLabel"
          tools:ignore="UseAppTint"
          android:background="?android:attr/selectableItemBackgroundBorderless"
          android:contentDescription="@string/clipboard_clear_search"
          android:scaleType="centerInside"
          android:padding="4dp"
          android:visibility="gone"/>

      <TextView
          android:id="@+id/clipboard_regex_toggle"
          android:text="@string/glyph_regex_toggle"
          android:layout_width="28dp"
          android:layout_height="28dp"
          android:gravity="center"
          android:textSize="12sp"
          android:typeface="monospace"
          android:textColor="?attr/colorLabel"
          android:alpha="0.4"
          android:clickable="true"
          android:focusable="true"
          android:background="?android:attr/selectableItemBackgroundBorderless"
          android:contentDescription="@string/clipboard_toggle_regex"
          android:visibility="gone"/>
    </LinearLayout>

    <!-- Status row. It stays empty in the resting state: Gboard shows clips, not a result
         counter. Filters, selection and pagination still need it, so the views remain. -->
    <LinearLayout android:id="@+id/clipboard_result_controls"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="8dp"
        android:paddingEnd="8dp" android:background="?attr/colorKeyboard">
      <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
          android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/clipboard_selection_count" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="12sp" android:textStyle="bold"
            android:maxLines="1" android:ellipsize="end" android:visibility="gone"
            android:textColor="?attr/colorLabel" android:accessibilityLiveRegion="polite"/>
        <TextView android:id="@+id/clipboard_result_summary" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="12sp"
            android:maxLines="1" android:ellipsize="end" android:visibility="gone"
            android:textColor="?attr/colorSubLabel" android:accessibilityLiveRegion="polite"/>
        <TextView android:id="@+id/clipboard_bulk_feedback" android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2" android:ellipsize="end"
            android:textSize="12sp" android:textColor="?attr/colorLabel" android:visibility="gone"
            android:accessibilityLiveRegion="polite"/>
      </LinearLayout>
      <LinearLayout
          android:id="@+id/clipboard_pagination_bar"
          android:layout_width="wrap_content"
          android:layout_height="48dp"
          android:orientation="horizontal"
          android:gravity="center"
          android:background="?attr/colorKey"
          android:visibility="gone">

        <TextView
            android:id="@+id/clipboard_page_prev"
            android:text="@string/glyph_page_prev"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textSize="16sp"
            android:textColor="?attr/colorLabel"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground"/>

        <TextView
            android:id="@+id/clipboard_page_info"
            tools:text="1 / 1"
            android:layout_width="wrap_content"
            android:minWidth="48dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textSize="12sp"
            android:textColor="?attr/colorSubLabel"/>

        <TextView
            android:id="@+id/clipboard_page_next"
            android:text="@string/glyph_page_next"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textSize="16sp"
            android:textColor="?attr/colorLabel"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground"/>
      </LinearLayout>
      <Button android:id="@+id/clipboard_swipe_undo" android:layout_width="wrap_content"
          android:layout_height="48dp" android:minWidth="48dp" android:text="@string/clipboard_swipe_undo"
          android:backgroundTint="?attr/colorKey" android:textColor="?attr/colorLabel"
          android:visibility="gone"/>
    </LinearLayout>

    <!-- Selection actions, VISIBLE only in selection mode. Five 48dp targets. -->
    <LinearLayout android:id="@+id/clipboard_selection_bar"
        android:layout_width="match_parent" android:layout_height="48dp"
        android:orientation="horizontal" android:gravity="center_vertical|end"
        android:background="?attr/colorKeyboard" android:visibility="gone">
      <ImageButton android:id="@+id/clipboard_select_matching"
          android:layout_width="48dp" android:layout_height="48dp"
          android:src="@drawable/ic_check_box_outline"
          android:tint="?attr/colorLabel" tools:ignore="UseAppTint"
          android:background="?android:attr/selectableItemBackgroundBorderless"
          android:scaleType="centerInside" android:padding="12dp"
          android:contentDescription="@string/clipboard_select_all_matching"/>
      <ImageButton android:id="@+id/clipboard_selection_clear"
          android:layout_width="48dp" android:layout_height="48dp"
          android:src="@drawable/ic_clear_all"
          android:tint="?attr/colorLabel" tools:ignore="UseAppTint"
          android:background="?android:attr/selectableItemBackgroundBorderless"
          android:scaleType="centerInside" android:padding="12dp"
          android:contentDescription="@string/clipboard_selection_clear"/>
      <ImageButton android:id="@+id/clipboard_selection_actions"
          android:layout_width="48dp" android:layout_height="48dp"
          android:src="@drawable/ic_more_vert"
          android:tint="?attr/colorLabel" tools:ignore="UseAppTint"
          android:background="?android:attr/selectableItemBackgroundBorderless"
          android:scaleType="centerInside" android:padding="12dp"
          android:contentDescription="@string/clipboard_selection_actions"/>
      <ImageButton android:id="@+id/clipboard_delete_selected"
          android:layout_width="48dp" android:layout_height="48dp"
          android:src="@drawable/ic_delete"
          android:tint="?attr/colorLabel" tools:ignore="UseAppTint"
          android:background="?android:attr/selectableItemBackgroundBorderless"
          android:scaleType="centerInside" android:padding="12dp"
          android:contentDescription="@string/clipboard_delete_selected"/>
      <ImageButton android:id="@+id/clipboard_selection_exit"
          android:layout_width="48dp" android:layout_height="48dp"
          android:src="@drawable/ic_clipboard_cancel"
          android:tint="?attr/colorLabel" tools:ignore="UseAppTint"
          android:background="?android:attr/selectableItemBackgroundBorderless"
          android:scaleType="centerInside" android:padding="12dp"
          android:contentDescription="@string/clipboard_selection_exit"/>
    </LinearLayout>
  </LinearLayout>

  <View
      android:layout_width="match_parent"
      android:layout_height="1dp"
      android:background="?attr/clipboard_divider_color"/>

  <!-- Content area: a Gboard-style section label above the rounded clip cards. -->
  <ScrollView
      android:id="@+id/clipboard_content_scroll"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:clipToPadding="false"
      android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

      <TextView
          android:id="@+id/clipboard_section_label"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:paddingStart="16dp"
          android:paddingEnd="16dp"
          android:paddingTop="10dp"
          android:paddingBottom="6dp"
          android:text="@string/clipboard_section_recent"
          android:textSize="13sp"
          android:textColor="?attr/colorSubLabel"
          android:maxLines="1"
          android:ellipsize="end"/>

      <!-- Gboard's arrangement: two clip cards per row. The adapter keeps one position per
           clip; GridView does the row-major placement. -->
      <tribixbite.cleverkeys.ClipboardHistoryView
          android:id="@+id/clipboard_history_view"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:numColumns="2"
          android:stretchMode="columnWidth"
          android:horizontalSpacing="0dp"
          android:verticalSpacing="0dp"
          android:divider="@null"
          android:dividerHeight="0dp"/>
    </LinearLayout>
  </ScrollView>

  <!-- Inline tag panel: replaces entry list when managing tags for an entry. -->
  <ScrollView
      android:id="@+id/clipboard_tag_panel"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:visibility="gone"
      android:background="?attr/colorKeyboard">

    <LinearLayout
        android:id="@+id/clipboard_tag_panel_content"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"/>
  </ScrollView>

</tribixbite.cleverkeys.ClipboardPaneLayout>
