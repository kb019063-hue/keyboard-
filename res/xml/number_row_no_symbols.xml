<?xml version="1.0" encoding="utf-8"?>
<!-- Same pitch as a letter row, as on Gboard: a compact (0.75-row) digit strip reads as
     a different keyboard above the letter keys. -->
<row>
  <key key0="1"/>
  <key key0="2"/>
  <key key0="3"/>
  <key key0="4"/>
  <key key0="5"/>
  <key key0="6"/>
  <key key0="7"/>
  <key key0="8"/>
  <key key0="9"/>
  <key key0="0"/>
</row>
