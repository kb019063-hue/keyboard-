<?xml version="1.0" encoding="utf-8"?>
<!-- QWERTY (Gboard-style): a US-English letter pane laid out like Gboard's default
Android keyboard (Gboard 16, portrait, number row ON). Layout only: "Gboard-style"
describes the arrangement; this layout is not affiliated with or endorsed by Google, and
copies no artwork or fonts.

References: the Gboard 16 default keyboard as photographed in 9to5Google's "Gboard now lets
you hide the period and comma keys" (2025-10-21,
https://9to5google.com/2025/10/21/gboard-period-comma-keys/), and the Gboard settings it
documents (Preferences: comma and period keys on, by default), plus the owner's own Gboard
on-device observation (Gboard 16, portrait, number row enabled, one corner hint per letter).

What is mimicked, top to bottom:
- a full-width number row, ten equal keys, digits only — Gboard prints no symbol hints
  next to them (the symbols are on the ?123 pane and behind long-press);
- three letter rows, each letter carrying ONE small symbol in its north-east corner, which
  is what Gboard prints (`%` above Q, `@` above A, and so on). The set below was transcribed
  from the owner's own Gboard 16 in shift state; the two letters whose Gboard hint duplicates
  another key's (`f`/`h` both dash, `e`/`c` both apostrophe) carry the nearest distinct symbol
  instead, because `KeyboardData.getKeys()` is keyed by value and a repeat would silently drop
  a position. The digits are NOT hinted on the top row: the number row above already shows
  them, which is what Gboard does when its own number row is switched on;
- the second row indented by half a key; Shift and Delete 1.5 keys wide;
- bottom row "?123 | , | emoji | space | . | enter" at 1.5 / 1 / 1 / 4 / 1 / 1.5 key widths, the
  emoji key standing on its own where Gboard draws it, and a bare comma and period: Gboard
  prints nothing on those two, so their old corner hints moved onto the letters above
  (? on M, ! on N, : on V, - on F, apostrophe on E).

How the Gboard features map onto CleverKeys keys:
- ?123 is `switch_numeric` with a "?123" label. It opens CleverKeys' own number pane; the
  Gboard ?123 / =\< symbol panes cannot be expressed by a layout file.
- Comma: swipe up for emoji (Gboard: hold comma); settings, clipboard, GIF and the
  keyboard picker (Gboard's language key) sit on its other corners.
- Period: Gboard's hold-period punctuation popup becomes ? ! ' - : on its corners.
- Gboard's space-bar cursor slide maps to the space bar's cursor_left / cursor_right.
- Ctrl, Fn, the arrow keys and the remaining CleverKeys bottom-row keys stay reachable as
  corner swipes on ?123, enter, Shift and Delete.

`loc` corners are placement markers, never printed (see Keyboard2View's draw loop): they say
where a key would go if the layout ever grows it, so nothing here is decoration the user has
to decode. Each placement value appears once: `esc` lives on backspace, not also on Q.
`KeyboardData.getKeys()` is keyed by value, so a duplicate silently loses one position.

embedded_number_row="true" tells LayoutModifier not to add the optional number row a second
time, so turning that preference on cannot produce two rows of digits on this layout.
-->
<keyboard name="QWERTY (Gboard-style)" script="latin" bottom_row="false" embedded_number_row="true">
  <row height="0.75">
    <key c="1"/>
    <key c="2"/>
    <key c="3"/>
    <key c="4"/>
    <key c="5"/>
    <key c="6"/>
    <key c="7"/>
    <key c="8"/>
    <key c="9"/>
    <key c="0"/>
  </row>
  <row>
    <key c="q" ne="%"/>
    <key c="w" ne="`"/>
    <key c="e" ne="'" sw="loc €"/>
    <key c="r" ne="="/>
    <key c="t" ne="|"/>
    <key c="y" ne="]"/>
    <key c="u" ne="&lt;"/>
    <key c="i" ne="&gt;"/>
    <key c="o" ne="{"/>
    <key c="p" ne="}"/>
  </row>
  <row>
    <key shift="0.5" c="a" ne="@"/>
    <key c="s" ne="#" sw="loc ß"/>
    <key c="d" ne="$"/>
    <key c="f" ne="-"/>
    <key c="g" ne="&amp;"/>
    <key c="h" ne="_"/>
    <key c="j" ne="+"/>
    <key c="k" ne="("/>
    <key c="l" ne=")"/>
  </row>
  <row>
    <key width="1.5" c="shift" nw="home" ne="end" se="loc tab" sw="loc capslock"/>
    <key c="z" ne="*"/>
    <key c="x" ne="&quot;" se="loc †"/>
    <key c="c" ne="/"/>
    <key c="v" ne=":"/>
    <key c="b" ne=";"/>
    <key c="n" ne="!"/>
    <key c="m" ne="?"/>
    <key width="1.5" c="backspace" nw="delete_last_word" ne="delete" sw="loc esc" se="loc menu" n="loc page_up" s="loc page_down"/>
  </row>
  <!-- Gboard's bottom row, in Gboard's order and widths: ?123 (1.5) | , (1) | emoji (1) |
       space (4) | . (1) | enter (1.5). The emoji key is its OWN key, not a hint on the comma:
       that is where Gboard draws it and the owner reported "I don't see the emoji button", which
       was exactly the cost of hiding it on a corner. It carries no corner hints, also like
       Gboard: a value may appear only once in a whole layout (Key.getKeys is keyed by value), so
       corners here would either duplicate the comma's own commands or shadow them. -->
  <row height="0.95">
    <key width="1.5" c="?123:switch_numeric" nw="ctrl" ne="fn" sw="loc switch_greekmath" se="loc meta" n="loc alt" s="loc compose"/>
    <key c="," nw="loc change_method" sw="loc switch_clipboard" se="switch_gif" s="switch_back_clipboard"/>
    <key c="switch_emoji"/>
    <key width="4" c="space" n="loc switch_forward" s="loc switch_backward" w="cursor_left" e="cursor_right"/>
    <key c="."/>
    <key width="1.5" c="enter" nw="loc voice_typing" ne="action" n="up" s="down" w="left" e="right" sw="doc_home" se="doc_end"/>
  </row>
</keyboard>
